# Copy this file to .env and fill in your actual keys.
# DO NOT commit .env to Git.

# Gemini API Key from Google AI Studio
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Fit does not use an API key.
# It uses OAuth 2.0 via Google Sign-In.
# Configure OAuth client IDs in Google Cloud Console and ensure
# the Fitness API is enabled. The client IDs are embedded in:
# - android/app/google-services.json
# - ios/Runner/GoogleService-Info.plist
